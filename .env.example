EVE_USERNAME=admin
EVE_PASSWORD=
EVE_SSH_USERNAME=root
EVE_SSH_PASSWORD=
EVE_DHCP_DNS=8.8.8.8,1.1.1.1
CISCO_USERNAME=admin
CISCO_PASSWORD=
CISCO_ENABLE_SECRET=
PALO_USERNAME=admin
PALO_PASSWORD=

# Versa init keeps the existing default username, role, and login shell.
# *_USERNAME must match the default console/shell account on your image.
# *_PASSWORD is the NEW desired password.
# *_CURRENT_PASSWORD is the current/default password for first-time init.
# After the password changes successfully, clear *_CURRENT_PASSWORD.
# If blank, init logs in using *_PASSWORD. No factory passwords are guessed.

# VOS routers and Controller share these credentials.
VERSA_USERNAME=admin
VERSA_PASSWORD=
VERSA_CURRENT_PASSWORD=

# Director default shell account; capitalization matters.
# This does not change the Director GUI/provider password.
VERSA_DIRECTOR_USERNAME=Administrator
VERSA_DIRECTOR_PASSWORD=
VERSA_DIRECTOR_CURRENT_PASSWORD=

# Analytics default shell account, not GUI/database/service credentials.
VERSA_ANALYTICS_USERNAME=versa
VERSA_ANALYTICS_PASSWORD=
VERSA_ANALYTICS_CURRENT_PASSWORD=
